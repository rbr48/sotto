# Access logging is deliberately not enabled: Sotto keeps no request logs.
{
	admin off
	# Pinned so coturn finds the certificate at a predictable path
	# (see coturn/start.sh).
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	# Behind another reverse proxy (install.sh --behind-proxy), trust its
	# X-Forwarded-For so the relay sees each client's own address for its
	# per-address connection limit. Otherwise nothing is trusted (Caddy itself
	# is the only thing at 127.0.0.1 in its container).
	servers {
		trusted_proxies static {$SOTTO_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

{$SOTTO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
		Content-Security-Policy "default-src 'none'; manifest-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; img-src 'self' data: blob:; connect-src 'self' blob: data: wss: https:; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
		-Server
	}

	# The relay takes the last X-Forwarded-For entry: send only the client's
	# address, not the chain of proxies.
	handle /health {
		reverse_proxy relay:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Signaling relay (WebSocket). Sees only encrypted envelopes.
	handle /relay {
		reverse_proxy relay:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	@download_page path /download /download/ /downloads /downloads/ /downloads.html
	redir @download_page https://sottocall.com/#download 308

	# Static files: return 404 if missing, do not rewrite to index.html
	@static path *.js *.wasm *.css *.json *.png *.jpg *.jpeg *.webp *.svg *.ico *.ttf *.woff *.woff2 *.map
	handle @static {
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}

	handle {
		# The app's files keep their names from one version to the next:
		# browsers must check with the server (a quick "not modified" when
		# nothing changed) instead of running a copy they kept, or people
		# would keep using an old version after an update.
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} {path}.html /index.html
		# The privacy policy and terms name the operator (SOTTO_OPERATOR,
		# SOTTO_CONTACT and, if set, SOTTO_SUPPORT_EMAIL and SOTTO_SUPPORT_LINK
		# from .env).
		@legal path /privacy.html /terms.html
		templates @legal
		file_server
	}
}

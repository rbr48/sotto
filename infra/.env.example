SOTTO_DOMAIN=call.sottocall.com
SOTTO_OPERATOR=Sotto (Izhaan Intellect)
SOTTO_CONTACT=contact@sottocall.com
# Optional: shown on /privacy.html and /terms.html only when set.
SOTTO_SUPPORT_EMAIL=support@sottocall.com
SOTTO_SUPPORT_LINK=https://call.sottocall.com/#c=n3qJ6HlYC0WI3DU_ixZTW6VaXCTX04zQTw5FjPj20CQ

# Shared secret between the relay and coturn for TURN credentials.
# Generate one with:  openssl rand -hex 32
SOTTO_TURN_SECRET=

# Only needed if the server is behind NAT (its public IP isn't on an interface).
# SOTTO_TURN_EXTERNAL_IP=148.135.137.245

# Bandwidth cap of each relayed connection (what relayed calls and file transfers use),
# in bytes per second and per direction. The default (12500000) is about 100 Mbit/s.
# Lower it to protect the server's bandwidth; the server's own link is the real limit
# either way.
# SOTTO_TURN_MAX_BPS=12500000

<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "windows-app": the Flutter Windows build
     (uploaded as a GitHub artifact, so a zip). Only Sotto's own program is
     signed; the Flutter engine and plugin libraries are not ours to sign. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="sotto.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
